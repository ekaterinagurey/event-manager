{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=eventapi;Username=postgres;Password=${EVENT_DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "EventApi",
    "Audience": "EventManagerClient",
    "Expires": 15
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service-group"
  },
  "AllowedHosts": "*"
}
