{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=bookingapi;Username=postgres;Password=${BOOKING_DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "EventManager",
    "Audience": "EventManagerClient",
    "Expires": 15
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "ServiceName": "bookings-service",
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
