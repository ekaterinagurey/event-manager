{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=eventapi;Username=postgres;Password=${EVENT_DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "EventManager",
    "Audience": "EventManagerClient",
    "Expires": 15
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Password": "${REDIS_SECRET}",
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 3000,
    "EventByIdTtlMinutes": 10,
    "TopEventsTtlMinutes": 2
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service-group"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
