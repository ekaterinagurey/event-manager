<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>12cd6724-53a0-450c-9c78-1a12343559fd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elven.Observability.Instrumentation.EntityFrameworkCore" Version="0.1.13" />
