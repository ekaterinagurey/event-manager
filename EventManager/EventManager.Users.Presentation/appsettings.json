{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=userapi;Username=postgres;Password=${USER_DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "UserApi",
    "Audience": "EventManagerClient",
    "Expires": 15
  },
  "AllowedHosts": "*"
}
